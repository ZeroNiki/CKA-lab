#!/usr/bin/env bash
# CKA Lab entry point: one command to bring the stand (and later the trainer) up or down.
set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")"

# Everything (go, vagrant, shellcheck) comes from the flake devShell; without Nix, install go and vagrant yourself.
if ! command -v go >/dev/null; then
  if ! command -v nix >/dev/null; then
    echo "go not found: install Go and Vagrant, or Nix with flakes (see README)" >&2
    exit 1
  fi
  exec nix develop --command "$0" "$@"
fi

LAB_DIR=".lab"
NODES=(controlplane node01 node02)
ADDR="127.0.0.1:8080"
PID_FILE="$LAB_DIR/server.pid"
PROVIDER_FILE="$LAB_DIR/provider"

# The choice is remembered: later commands (ssh, reset) must use the Vagrantfile the VMs were created with.
if [[ -n "${LAB_PROVIDER:-}" ]]; then
  PROVIDER="$LAB_PROVIDER"
elif [[ -f "$PROVIDER_FILE" ]]; then
  PROVIDER="$(cat "$PROVIDER_FILE")"
else
  PROVIDER="libvirt"
fi
case "$PROVIDER" in
  libvirt) export VAGRANT_VAGRANTFILE=Vagrantfile ;;
  virtualbox) export VAGRANT_VAGRANTFILE=Vagrantfile.virtualbox ;;
  *)
    echo "unknown LAB_PROVIDER=$PROVIDER (libvirt | virtualbox)" >&2
    exit 2
    ;;
esac

usage() {
  cat >&2 <<'EOF'
usage: [LAB_PROVIDER=libvirt|virtualbox] ./lab <command>
  up            start VMs (create on first run), install addons, start the trainer UI
  down            stop the trainer and the VMs
  ssh [node]      shell on a node (default: controlplane)
  snapshot-base   save snapshot "clean" of all nodes (once, after first up)
  reset           restore all nodes to snapshot "clean"
  selftest ARGS   verify tasks: --all | --level <id> | <task-id>...
EOF
  exit 2
}

all_running() {
  local running
  running="$(vagrant status --machine-readable | awk -F, '$3 == "state" && $4 == "running"' | wc -l)"
  [[ "$running" -eq "${#NODES[@]}" ]]
}

cmd_up() {
  mkdir -p "$LAB_DIR"
  echo "$PROVIDER" >"$PROVIDER_FILE"
  if ! all_running; then
    # Sequential: controlplane is defined first and must finish kubeadm init before workers join.
    vagrant up --provider="$PROVIDER" --no-parallel
  fi
  # Idempotent and quick when already installed; re-running heals a half-finished first up.
  vagrant provision controlplane --provision-with addons
  # The kubeconfig grants cluster-admin: keep it private and never print it.
  (umask 077 && vagrant ssh controlplane -c 'sudo cat /etc/kubernetes/admin.conf' >"$LAB_DIR/kubeconfig" 2>/dev/null)
  vagrant ssh-config >"$LAB_DIR/ssh_config"
  start_server
  echo "Cluster is up. Work on the control plane with: ./lab ssh"
}

server_running() {
  [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

start_server() {
  go build -o "$LAB_DIR/cka-lab" ./cmd/cka-lab
  # Restart so a freshly built binary and edited content are always picked up.
  stop_server
  nohup "$LAB_DIR/cka-lab" serve -addr "$ADDR" >"$LAB_DIR/server.log" 2>&1 &
  echo $! >"$PID_FILE"
  local deadline=$((SECONDS + 15))
  until curl -sf "http://$ADDR/api/state" >/dev/null; do
    if ((SECONDS > deadline)) || ! server_running; then
      echo "trainer did not start, see $LAB_DIR/server.log:" >&2
      tail -n 20 "$LAB_DIR/server.log" >&2
      exit 1
    fi
    sleep 0.5
  done
  echo "Trainer: http://$ADDR"
  xdg-open "http://$ADDR" >/dev/null 2>&1 || true
}

stop_server() {
  if server_running; then
    kill "$(cat "$PID_FILE")"
    # Wait for the port to be released before a restart binds it again.
    while server_running; do sleep 0.2; done
  fi
  rm -f "$PID_FILE"
}

cmd_down() {
  stop_server
  vagrant halt
}

case "${1:-}" in
  up) cmd_up ;;
  down) cmd_down ;;
  ssh) vagrant ssh "${2:-controlplane}" ;;
  snapshot-base) vagrant snapshot save clean ;;
  reset) vagrant snapshot restore --no-provision clean ;;
  selftest)
    shift
    go build -o "$LAB_DIR/cka-lab" ./cmd/cka-lab
    "$LAB_DIR/cka-lab" selftest "$@"
    ;;
  *) usage ;;
esac
